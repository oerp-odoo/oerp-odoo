<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="tpl_service_view_list" model="ir.ui.view">
        <field name="name">tpl.service.list</field>
        <field name="model">tpl.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="integration"/>
            </list>
        </field>
    </record>

    <record id="tpl_service_view_form" model="ir.ui.view">
        <field name="name">tpl.service.form</field>
        <field name="model">tpl.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="general" string="General">
                            <field name="integration"/>
                            <field
                                name="http_client_profile_id"
                                required="integration"
                            />
                        </group>
                        <group name="options" string="Options">
                            <field name="invoice_state_target"/>
                            <field
                                name="invoice_state_email"
                                invisible="invoice_state_target not in ('open', 'paid')"
                            />
                            <field
                                name="journal_id"
                                invisible="invoice_state_target != 'paid'"
                                required="invoice_state_target == 'paid'"
                            />
                            <field
                                name="warehouse_id"
                                options="{'no_create_edit': True}"
                            />
                        </group>
                        <group name="filters" string="Filters">
                            <field
                                name="filter_expression"
                                placeholder="e.g. sale.partner_id.country_id.code == 'LT'"
                            />
                        </group>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="tpl_service_action" model="ir.actions.act_window">
        <field name="name">3PL Services</field>
        <field name="res_model">tpl.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="tpl_service_menu"
        parent="tpl_root_menu"
        action="tpl_service_action"
        sequence="5"
    />
</odoo>
