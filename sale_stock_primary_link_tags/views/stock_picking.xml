<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="vpicktree_inherit" model="ir.ui.view">
        <field name="name">stock.picking.tree.sale.primary.tags</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="sale_stock_primary_link.vpicktree_inherit"/>
        <field name="arch" type="xml">
            <field name="sale_primary_id" position="after">
                <field
                    name="sale_primary_tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.sale.primary.tags</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="sale_stock_primary_link.view_picking_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="sale_primary_id" position="after">
                <field
                    name="sale_primary_tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </field>
        </field>
    </record>
</odoo>
