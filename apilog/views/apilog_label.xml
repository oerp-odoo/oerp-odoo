<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="apilog_label_view_tree" model="ir.ui.view">
        <field name="name">apilog.label.tree</field>
        <field name="model">apilog.label</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="apilog_label_view_form" model="ir.ui.view">
        <field name="name">apilog.label.form</field>
        <field name="model">apilog.label</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group name="right">
                            <field name="parent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="apilog_label_action" model="ir.actions.act_window">
        <field name="name">Labels</field>
        <field name="res_model">apilog.label</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="apilog_label_menu"
        parent="apilog_root_menu"
        action="apilog_label_action"
        sequence="10"
    />
</odoo>
