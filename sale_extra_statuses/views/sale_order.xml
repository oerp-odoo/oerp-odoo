<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.extra.statuses</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="picking_ids" column_invisible="1"/>
                <field name="component_availability_state" column_invisible="1"/>
                <field name="purchase_status" optional="show"/>
                <field
                    name="component_progress"
                    decoration-success="component_availability_state == 'available'"
                    decoration-warning="component_availability_state == 'unavailable'"
                    decoration-danger="component_availability_state == 'late'"
                    widget="progressbar"
                    optional="show"
                    class="d-flex offset-3"
                    invisible="not component_availability_state"
                />
                <field
                    name="production_progress"
                    widget="progressbar"
                    optional="show"
                    class="d-flex offset-3"
                    invisible="not production_from_primary_ids"
                />
                <field
                    name="delivery_progress"
                    widget="progressbar"
                    optional="show"
                    class="d-flex offset-3"
                    invisible="not picking_ids"
                />
            </field>
        </field>
    </record>
</odoo>
