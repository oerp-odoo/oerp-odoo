<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="http_client_profile_view_list" model="ir.ui.view">
        <field name="name">http.client.profile.list</field>
        <field name="model">http.client.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="integration"/>
                <field name="base_url"/>
                <field name="auth_id"/>
                <field name="retry_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="http_client_profile_view_form" model="ir.ui.view">
        <field name="name">http.client.profile.form</field>
        <field name="model">http.client.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="general" string="General">
                            <field name="name"/>
                            <field name="integration"/>
                            <field name="base_url"/>
                            <field name="auth_id"/>
                            <field name="retry_id"/>
                            <field
                                name="non_ok_exception_path"
                                placeholder="odoo.exceptions.ValidationError"
                            />
                        </group>
                        <group name="misc" string="Misc">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="http_client_profile_action" model="ir.actions.act_window">
        <field name="name">Profiles</field>
        <field name="res_model">http.client.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="http_client_profile_menu"
        parent="http_client_root_menu"
        action="http_client_profile_action"
        sequence="5"
    />
</odoo>
