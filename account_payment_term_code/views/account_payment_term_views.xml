<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payment_term_tree_inherit" model="ir.ui.view">
        <field name="name">account.payment.term.tree.code</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_pricelist_view_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.term.form.code</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code"/>
            </field>
        </field>
    </record>
</odoo>
