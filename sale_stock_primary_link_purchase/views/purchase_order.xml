<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_kpis_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.rfq.tree.sale.primary</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="sale_primary_id" optional="show"/>
            </field>
        </field>
    </record>
    <record id="purchase_order_view_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.sale.primary</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="sale_primary_id" optional="show"/>
            </field>
        </field>
    </record>
    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.sale.primary</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="sale_primary_id"/>
            </field>
        </field>
    </record>
</odoo>
