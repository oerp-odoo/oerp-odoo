<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_stamp_view_tree" model="ir.ui.view">
        <field name="name">package.stamp.tree</field>
        <field name="model">package.stamp</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cost"/>
            </tree>
        </field>
    </record>

    <record id="package_stamp_view_form" model="ir.ui.view">
        <field name="name">package.stamp.form</field>
        <field name="model">package.stamp</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="stamp_type"/>
                            <field name="cost"/>
                        </group>
                        <group name="right">
                            <field
                                name="area_range_from_id"
                                options="{'no_create': True}"
                            />
                            <field
                                name="area_range_to_id"
                                options="{'no_create': True}"
                            />
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="package_stamp_action" model="ir.actions.act_window">
        <field name="name">Stamps</field>
        <field name="res_model">package.stamp</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
