<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_labor_item_view_tree" model="ir.ui.view">
        <field name="name">package.labor.item.tree</field>
        <field name="model">package.labor.item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="labor_id"/>
                <field name="labor_type_id"/>
                <field name="custom_name"/>
                <field name="units_per_hour"/>
                <field name="setup_minutes"/>
            </tree>
        </field>
    </record>

    <record id="package_labor_item_view_form" model="ir.ui.view">
        <field name="name">package.labor.item.form</field>
        <field name="model">package.labor.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="is_generic" invisible="1"/>
                            <field name="labor_id"/>
                            <field name="labor_type_id"/>
                            <field name="custom_name" readonly="not is_generic"/>
                        </group>
                        <group name="right">
                            <field name="units_per_hour"/>
                            <field name="setup_minutes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="package_labor_item_action" model="ir.actions.act_window">
        <field name="name">Labor Items</field>
        <field name="res_model">package.labor.item</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
