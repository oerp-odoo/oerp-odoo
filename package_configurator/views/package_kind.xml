<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_kind_view_tree" model="ir.ui.view">
        <field name="name">package.kind.tree</field>
        <field name="model">package.kind</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="package_type_id"/>
            </tree>
        </field>
    </record>

    <record id="package_kind_view_form" model="ir.ui.view">
        <field name="name">package.kind.form</field>
        <field name="model">package.kind</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="name"/>
                            <field name="package_type_id"/>
                            <field
                                name="default_component_ids"
                                widget="many2many_tags"
                            />
                        </group>
                        <group name="right">
                            <field name="min_length"/>
                            <field name="min_width"/>
                            <field name="min_height"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="package_kind_action" model="ir.actions.act_window">
        <field name="name">Package Kinds</field>
        <field name="res_model">package.kind</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
