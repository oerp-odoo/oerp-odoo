<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_configurator_circulation_view_tree" model="ir.ui.view">
        <field name="name">package.configurator.circulation.tree</field>
        <field name="model">package.configurator.circulation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_cost"/>
                <field name="total_lamination_cost"/>
            </tree>
        </field>
    </record>

    <record id="package_configurator_circulation_view_form" model="ir.ui.view">
        <field name="name">package.configurator.circulation.form</field>
        <field name="model">package.configurator.circulation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="quantities" string="Quantities">
                            <field name="quantity"/>
                        </group>
                        <group name="costs" string="Costs">
                            <field name="unit_cost"/>
                            <field name="total_lamination_cost"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="circulation_items" string="Items">
                            <field name="item_ids">
                                <tree>
                                    <button
                                        name="action_open_circulation_setups"
                                        type="object"
                                        title="Circultion Setups"
                                        icon="fa-wrench"
                                    />
                                    <field name="component_id"/>
                                    <field name="print_unit_cost"/>
                                    <field name="stamp_cost"/>
                                    <field name="foil_cost"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                        <page name="circulation_labors" string="Labor">
                            <field name="circulation_labor_ids">
                                <tree editable="bottom">
                                    <button
                                        name="action_open_circulation_labor_processes"
                                        type="object"
                                        title="Labor Processes"
                                        icon="fa-gears"
                                    />
                                    <field name="labor_id"/>
                                    <field name="hour_profit"/>
                                    <field name="total_labor_hours"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="unit_profit"/>
                                    <field name="total_profit"/>
                                    <field name="total_price"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="package_configurator_circulation_action" model="ir.actions.act_window">
        <field name="name">Circulations</field>
        <field name="res_model">package.configurator.circulation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
