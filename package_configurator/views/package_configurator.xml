<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_configurator_view_tree" model="ir.ui.view">
        <field name="name">package.configurator.tree</field>
        <field name="model">package.configurator</field>
        <field name="arch" type="xml">
            <tree>
                <field name="package_type_id" invisible="1"/>
                <field name="lid_used" invisible="1"/>
                <field name="create_date"/>
                <field name="package_kind_id"/>
                <field name="print_house_id"/>
                <field name="base_length"/>
                <field name="base_width"/>
                <field name="base_height"/>
                <field name="lid_height" invisible="not lid_used"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="package_configurator_view_form" model="ir.ui.view">
        <field name="name">package.configurator.form</field>
        <field name="model">package.configurator</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_setup" string="Setup" type="object"/>
                    <!-- TODO: add state field with statusbar widget -->
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_cfg_inserts"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-external-link-square"
                            invisible="package_type_code != 'box'"
                        >
                            <field
                                name="configurator_insert_count"
                                widget="statinfo"
                                string="Inserts"
                            />
                        </button>
                    </div>
                    <group name="main">
                        <field name="package_type_id" invisible="1"/>
                        <field name="package_type_code" invisible="1"/>
                        <field name="component_length_width_editable" invisible="1"/>
                        <field
                            name="dimensions_visible"
                            invisible="1"
                            column_invisible="1"
                        />
                        <field name="lid_used" invisible="1"/>
                        <group name="main">
                            <group name="general" string="General">
                                <field
                                    name="configurator_box_id"
                                    options="{'no_create': True}"
                                    invisible="package_type_code != 'insert'"
                                />
                                <field name="package_kind_id"/>
                                <field name="print_house_id"/>
                            </group>
                            <group
                                name="dimensions"
                                string="Dimensions"
                                invisible="not dimensions_visible"
                            >
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th/>
                                            <th>Length</th>
                                            <th>Width</th>
                                            <th>Height</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Base</td>
                                            <td><field name="base_length"/></td>
                                            <td><field name="base_width"/></td>
                                            <td><field name="base_height"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <group>
                                    <field name="lid_height" invisible="not lid_used"/>
                                </group>
                            </group>
                            <!-- For now not visible to insert. -->
                            <group
                                name="extra"
                                string="Extra"
                                invisible="package_type_code == 'insert'"
                            >

                                <field name="outside_wrapping_extra"/>
                                <!-- Not intended to be showed via UI. -->
                                <field name="lid_extra" invisible="1"/>
                            </group>
                        </group>
                        <separator
                            name="warnings"
                            string="Warnings"
                            invisible="not description_warnings"
                        />
                        <field
                            name="description_warnings"
                            invisible="not description_warnings"
                        />
                    </group>
                    <notebook>
                        <page name="components" string="Components">
                            <field name="component_ids">
                                <tree editable="bottom">
                                    <field
                                        name="component_kind_ids"
                                        invisible="1"
                                        column_invisible="1"
                                    />
                                    <field
                                        name="component_kind_allowed_ids"
                                        invisible="1"
                                        column_invisible="1"
                                    />
                                    <field
                                        name="wrappingpaper_used"
                                        invisible="1"
                                        column_invisible="1"
                                    />
                                   <field
                                        name="component_type_allowed_ids"
                                        invisible="1"
                                        column_invisible="1"
                                    />
                                    <field name="component_type_id"/>
                                    <field
                                        name="sheet_type_id"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="sheet_id"
                                        options="{'no_create': True}"
                                    />
                                    <field
                                        name="print_color_id"
                                        column_invisible="not parent.print_house_id"
                                        readonly="not wrappingpaper_used"
                                    />
                                    <field
                                        name="_component_length"
                                        column_invisible="not parent.component_length_width_editable"
                                    />
                                    <field
                                        name="_component_width"
                                        column_invisible="not parent.component_length_width_editable"
                                    />
                                    <field name="component_length"/>
                                    <field name="component_width"/>
                                    <field name="fit_qty"/>
                                </tree>
                            </field>
                        </page>
                        <page name="circulations" string="Circulations">
                            <field name="circulation_ids"/>
                        </page>
                        <page name="stamps" string="Emboss/Deboss">
                            <field name="cfg_stamp_ids">
                                <tree editable="bottom">
                                    <field name="configurator_id" column_invisible="1"/>
                                    <field
                                        name="component_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="side"/>
                                    <field
                                        name="stamp_id"
                                        options="{'no_create': True}"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page name="foils" string="Foils">
                            <field name="cfg_foil_ids">
                                <tree editable="bottom">
                                    <field name="configurator_id" column_invisible="1"/>
                                    <field
                                        name="component_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="side"/>
                                    <field
                                        name="foil_id"
                                        options="{'no_create': True}"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page name="lamination" string="Lamination">
                            <field name="cfg_lamination_ids">
                                <tree editable="bottom">
                                    <field name="configurator_id" column_invisible="1"/>
                                    <field name="side"/>
                                    <field
                                        name="lamination_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="area"/>
                                    <field name="area_unit_cost"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="package_configurator_box_action" model="ir.actions.act_window">
        <field name="name">Box Configurator</field>
        <field name="res_model">package.configurator</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('package_type_id.code', '=', 'box')]</field>
        <field name="context">{'package_type_code': 'box'}</field>
    </record>

    <record id="package_configurator_insert_action" model="ir.actions.act_window">
        <field name="name">Insert Configurator</field>
        <field name="res_model">package.configurator</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('package_type_id.code', '=', 'insert')]</field>
        <field name="context">{'package_type_code': 'insert'}</field>
    </record>
</odoo>
