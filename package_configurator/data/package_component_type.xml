<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_component_type_base" model="package.component.type">
        <field name="name">Base</field>
        <field name="code">base</field>
        <field
            name="component_kind_ids"
            eval="
                [
                    Command.set(
                        [
                            ref('package_component_kind_greyboard'),
                            ref('package_component_kind_carton'),
                        ]
                    )
                ]"
        />
    </record>
