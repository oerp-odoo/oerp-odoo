<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="package_type_box" model="package.type">
        <field name="name">Box</field>
        <field name="code">box</field>
        <field
            name="component_kind_ids"
            eval="
                [
                    Command.set(
                        [
                            ref('package_component_kind_greyboard'),
                            ref('package_component_kind_wrappingpaper'),
                        ]
                    )
                ]"
        />
    </record>
    <record id="package_type_insert" model="package.type">
        <field name="name">Insert</field>
        <field name="code">insert</field>
        <field
            name="component_kind_ids"
            eval="
                [
                    Command.set(
                        [
                            ref('package_component_kind_carton'),
                            ref('package_component_kind_wrappingpaper'),
                        ]
                    )
                ]"
        />
    </record>
</odoo>
