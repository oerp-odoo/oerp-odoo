<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_pricelist_view_tree_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.tree.code</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code"/>
            </field>
        </field>
    </record>

    <record id="product_pricelist_view_form_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.form.code</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="code"/>
            </field>
        </field>
    </record>
</odoo>
